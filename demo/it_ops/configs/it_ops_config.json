{
  "name": "Centian IT Ops Demo",
  "version": "1.0.0",
  "auth": false,
  "proxy": {
    "host": "127.0.0.1",
    "port": "8577",
    "timeout": 30,
    "logLevel": "debug",
    "logOutput": "both",
    "logFile": "demo/it_ops/.centian/centian.log",
    "web": {
      "publicBaseUrl": "http://127.0.0.1:8577"
    },
    "capabilities": {
      "eventStorage": {
        "enabled": true,
        "driver": "sqlite",
        "path": "demo/it_ops/.centian/events.sqlite"
      },
      "ui": {
        "enabled": true
      }
    }
  },
  "gateways": {
    "it-ops": {
      "mcpServers": {
        "it-ops-mock": {
          "command": "node",
          "args": [
            "demo/it_ops/server/it_ops_server.mjs"
          ],
          "enabled": true,
          "description": "Small IT ops MCP mock server"
        }
      },
      "processors": [
        {
          "name": "prompt_injection_guard",
          "type": "cli",
          "enabled": true,
          "required": true,
          "timeout": 10,
          "parts": [
            "payload",
            "meta",
            "annotations"
          ],
          "config": {
            "command": "build/prompt-injection-guard",
            "args": [
              "--mode=annotate"
            ]
          }
        }
      ]
    }
  }
}
