FROM golang:1.26-bookworm AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/centian ./cmd/main.go

FROM python:3.12-slim

RUN apt-get update \
	&& apt-get install -y --no-install-recommends curl ca-certificates gnupg \
	&& curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
	&& apt-get install -y --no-install-recommends nodejs \
	&& pip install --no-cache-dir pytest ruff \
	&& npm install -g @modelcontextprotocol/server-filesystem shell-command-mcp \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /opt/centian

COPY --from=builder /out/centian /usr/local/bin/centian
COPY task-templates /opt/centian/task-templates
COPY demo/taskverification/configs/taskverification_config.json /etc/centian/configs/taskverification_config.json

ENTRYPOINT ["centian", "start", "--config-path", "/etc/centian/configs/taskverification_config.json"]
