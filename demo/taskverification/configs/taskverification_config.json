{
  "name": "Task Verification Demo",
  "version": "1.0.0",
  "auth": false,
  "proxy": {
    "host": "0.0.0.0",
    "port": "8080",
    "timeout": 30,
    "logLevel": "debug",
    "logOutput": "both",
    "logFile": "/artifacts/centian_internal.log",
    "capabilities": {
      "taskVerification": {
        "enabled": true,
        "templatesPath": "/opt/centian/task-templates"
      },
      "eventStorage": {
        "enabled": true,
        "driver": "sqlite"
      },
      "ui": {
        "enabled": true
      }
    }
  },
  "gateways": {
    "taskverification": {
      "setupGateway": true,
      "mcpServers": {
        "filesystem": {
          "command": "mcp-server-filesystem",
          "args": [
            "/workspace/project"
          ],
          "enabled": true,
          "description": "Filesystem access to the mounted Python sample project."
        },
        "shell": {
          "command": "shell-command-mcp",
          "args": [],
          "env": {
            "ALLOWED_COMMANDS": "*"
          },
          "enabled": true,
          "description": "Unsafe shell access for the task verification PoC."
        }
      }
    }
  }
}
